# uv / Python / build artifacts (uv.lock is intentionally tracked)
/.venv/
/venv/
/.uv-cache/
/.uv-python/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Raw market/disclosure data, ledgers, model replies and run outputs
/data/
/outputs/
/incoming/
/input/
/inputs/
/demo-*/
/backups/
/logs/
*.log
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*

# CSV is private by default; only authored documentation/test fixtures are shared
*.csv
!docs/*.csv
!tests/fixtures/*.csv

# Machine-specific configuration, credentials and local agent state
.env
.env.*
!.env.example
!.env.*.example
*.local.json
*.local.yaml
*.local.yml
credentials*.json
secrets*.json
/configs/local/
/configs/m5_drafts/
/configs/*_drafts/
*.pem
*.key
*.p12
*.pfx
.codex/
.agents/
.hermes/
.idea/
.vscode/

# Third-party downloads and model weights (runtime definitions remain tracked)
/vendor/
/models/
/model-cache/
/.cache/
*.safetensors
*.gguf
*.pt
*.pth
*.onnx
*.bin

# OS/editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.swp
*~
